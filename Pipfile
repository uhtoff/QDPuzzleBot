[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
ipython = "*"
pytest = "*"
pytest-asyncio = "*"
pydevd-pycharm = "~=243.22562.220"
ruff = "*"

[packages]
"discord.py" = "*"
mysql-connector-python = "*"
dataclasses-json = "*"
pytz = "*"
google-api-python-client = "*"
quart = "*"
aiohttp = "*"
python-slugify = "*"
# The "binary" extra is load-bearing: the wheel bundles libvips, so tiling needs
# no apt package and no root on the deploy host.
pyvips = {extras = ["binary"], version = "*"}
pytesseract = "*"

[requires]
python_version = "3.12"
